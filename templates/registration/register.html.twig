{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-950 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        {# Logo / Header #}
        <div class="text-center mb-8">

            <h1 class="text-3xl font-bold tracking-tight text-white">
                Créer un compte
            </h1>

            <p class="mt-2 text-sm text-slate-400">
                Rejoins-nous et commence dès maintenant.
            </p>
        </div>

        {# Card #}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 shadow-2xl shadow-black/20 backdrop-blur sm:p-8">

            {# Global errors #}
            {% if form_errors(registrationForm) %}
                <div class="mb-6 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {
                attr: {
                    class: 'space-y-5'
                }
            }) }}

                {# Username #}
                <div>
                    {{ form_label(registrationForm.username, null, {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-slate-200'
                        }
                    }) }}

                    {{ form_widget(registrationForm.username, {
                        attr: {
                            class: 'block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20',
                            placeholder: 'Votre nom d’utilisateur'
                        }
                    }) }}

                    {% if form_errors(registrationForm.username) %}
                        <div class="mt-2 text-sm text-red-400">
                            {{ form_errors(registrationForm.username) }}
                        </div>
                    {% endif %}
                </div>

                {# Email #}
                <div>
                    {{ form_label(registrationForm.email, null, {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-slate-200'
                        }
                    }) }}

                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20',
                            placeholder: 'vous@exemple.com'
                        }
                    }) }}

                    {% if form_errors(registrationForm.email) %}
                        <div class="mt-2 text-sm text-red-400">
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    {% endif %}
                </div>

                {# Password #}
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-slate-200'
                        }
                    }) }}

                    {{ form_widget(registrationForm.plainPassword, {
                        attr: {
                            class: 'block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20',
                            placeholder: '••••••••'
                        }
                    }) }}

                    {% if form_errors(registrationForm.plainPassword) %}
                        <div class="mt-2 text-sm text-red-400">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    {% endif %}
                </div>

                {# Terms #}
                <div class="flex items-start gap-3 rounded-xl">
                    {{ form_widget(registrationForm.agreeTerms, {
                        attr: {
                            class: 'mt-1 h-4 w-4 rounded border-slate-600 bg-slate-900 text-indigo-600 focus:ring-2 focus:ring-indigo-500'
                        }
                    }) }}

                    <div class="text-sm">
                        {{ form_label(registrationForm.agreeTerms, null, {
                            label_attr: {
                                class: 'cursor-pointer text-slate-300'
                            }
                        }) }}

                        {% if form_errors(registrationForm.agreeTerms) %}
                            <div class="mt-1 text-red-400">
                                {{ form_errors(registrationForm.agreeTerms) }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Submit #}
                <button
                    type="submit"
                    class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-500 hover:shadow-indigo-600/30 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900 active:scale-[0.99]"
                >
                    Créer mon compte
                </button>

            {{ form_end(registrationForm) }}

            {# Login link #}
            <p class="mt-6 text-center text-sm text-slate-400">
                Vous avez déjà un compte ?
                <a
                    href="{{ path('app_login') }}"
                    class="font-medium text-indigo-400 transition hover:text-indigo-300"
                >
                    Se connecter
                </a>
            </p>
        </div>

        <p class="mt-6 text-center text-xs text-slate-600">
            © {{ "now"|date("Y") }} — Tous droits réservés
        </p>
    </div>
</div>
{% endblock %}