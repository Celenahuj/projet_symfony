{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-950 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        {# Header #}
        <div class="text-center mb-8">

            <h1 class="text-3xl font-bold tracking-tight text-white">
                Se connecter
            </h1>

            <p class="mt-2 text-sm text-slate-400">
                Connecte-toi à ton compte pour continuer.
            </p>
        </div>

        {# Card #}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 shadow-2xl shadow-black/20 backdrop-blur sm:p-8">

            {# Error #}
            {% if error %}
                <div class="mb-6 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {# User already logged in #}
            {% if app.user %}
                <div class="mb-6 rounded-xl border border-indigo-500/20 bg-indigo-500/10 px-4 py-3 text-sm text-white">
                    Vous êtes connecté en tant que
                    <strong>{{ app.user.userIdentifier }}</strong>.
                    </br>
                    <a
                        href="{{ logout_path() }}"
                        class="font-medium text-indigo-400 hover:text-indigo-300"
                    >
                        Se déconnecter
                    </a>
                </div>
            {% endif %}

            <form method="post" class="space-y-5">

                {# Email #}
                <div>
                    <label
                        for="username"
                        class="mb-2 block text-sm font-medium text-slate-200"
                    >
                        Email
                    </label>

                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"
                        placeholder="vous@exemple.com"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                {# Password #}
                <div>
                    <label
                        for="password"
                        class="mb-2 block text-sm font-medium text-slate-200"
                    >
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"
                        placeholder="••••••••"
                        autocomplete="current-password"
                        required
                    >
                </div>

                {# CSRF #}
                <input
                    type="hidden"
                    name="_csrf_token"
                    data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}"
                >

                {# Remember me #}
                {#
                <div class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        name="_remember_me"
                        id="_remember_me"
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-indigo-600 focus:ring-2 focus:ring-indigo-500"
                    >

                    <label
                        for="_remember_me"
                        class="text-sm text-slate-300"
                    >
                        Se souvenir de moi
                    </label>
                </div>
                #}

                {# Submit #}
                <button
                    class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-500 hover:shadow-indigo-600/30 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900 active:scale-[0.99]"
                    type="submit"
                >
                    Se connecter
                </button>

            </form>

            {# Register link #}
            <p class="mt-6 text-center text-sm text-slate-400">
                Vous n'avez pas encore de compte ?
                <a
                    href="{{ path('app_register') }}"
                    class="font-medium text-indigo-400 transition hover:text-indigo-300"
                >
                    Créer un compte
                </a>
            </p>
        </div>

        <p class="mt-6 text-center text-xs text-slate-600">
            © {{ "now"|date("Y") }} — Tous droits réservés
        </p>

    </div>
</div>
{% endblock %}